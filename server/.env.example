# API settings
ULTRAGEN_DATA_DIR=./data
ULTRAGEN_CORS_ORIGINS=http://localhost:5173
ULTRAGEN_MAX_UPLOAD_MB=20

# Required by the separate inference worker. Keep this secret out of the browser.
ULTRAGEN_WORKER_TOKEN=replace-with-a-long-random-secret
ULTRAGEN_API_URL=http://127.0.0.1:8000
ULTRAGEN_POLL_SECONDS=3

# Optional provider plugin: python.module:ProviderClass
ULTRAGEN_PROVIDER=
